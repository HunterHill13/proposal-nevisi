{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClaimProvenanceSchema",
  "description": "Schema for scientific atomic claim provenance, causal verb auditing, and numerical traceability.",
  "type": "object",
  "required": ["claim_id", "claim_text", "source_ref_id", "entailment_level", "verdict"],
  "properties": {
    "claim_id": { "type": "string" },
    "claim_text": { "type": "string" },
    "source_ref_id": { "type": "string" },
    "source_study_design": { "type": "string" },
    "claim_type": {
      "type": "string",
      "enum": ["CAUSAL", "ASSOCIATIVE", "PREDICTIVE", "MECHANISTIC", "HYPOTHETICAL"]
    },
    "entailment_level": {
      "type": "string",
      "enum": [
        "FULLY_ENTAILED",
        "HIGH_FIDELITY",
        "PARTIALLY_ENTAILED",
        "EXTRAPOLATED",
        "UNSUPPORTED",
        "CONTRADICTED",
        "AMBIGUOUS"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": ["ENTAILED", "OVERCLAIM", "UNSUPPORTED", "CONTRADICTED"]
    },
    "numerical_ledger_id": { "type": ["string", "null"] },
    "has_overclaim_risk": { "type": "boolean" },
    "support_strength": {
      "type": "string",
      "enum": ["DIRECT", "PARTIAL", "ANALOGOUS", "INDIRECT", "INSUFFICIENT", "UNSUPPORTED"]
    },
    "evidence_relationship": {
      "type": "string",
      "enum": ["DIRECT", "CLOSE_ANALOG", "MECHANISTIC_SUPPORT", "METHOD_SUPPORT", "BACKGROUND", "INDIRECT"]
    },
    "flagged_issues": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

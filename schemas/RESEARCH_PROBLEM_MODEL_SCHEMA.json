{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchProblemModel",
  "description": "Dynamic domain model generated from user research questions across diverse biomedical disciplines.",
  "type": "object",
  "required": [
    "model_id",
    "research_title_fa",
    "research_title_en",
    "domain",
    "framework",
    "target_condition",
    "population_or_model",
    "interventions_or_exposures",
    "comparators",
    "primary_outcomes",
    "controlled_vocabulary"
  ],
  "properties": {
    "model_id": {
      "type": "string"
    },
    "research_title_fa": {
      "type": "string"
    },
    "research_title_en": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "framework": {
      "type": "string",
      "enum": [
        "PICO",
        "PECO",
        "DIAGNOSTIC",
        "DIAGNOSTIC_ACCURACY_AND_BIOMARKER",
        "PROGNOSTIC",
        "MECHANISTIC",
        "EXPERIMENTAL_IN_VITRO",
        "EXPERIMENTAL_ANIMAL",
        "CLINICAL_TRIAL",
        "HEALTH_SYSTEMS_AND_HEALTH_POLICY",
        "EPIDEMIOLOGICAL_OBSERVATIONAL",
        "SCOPING_REVIEW",
        "USABILITY_AND_DIGITAL_HEALTH",
        "USABILITY"
      ]
    },
    "target_condition": {
      "type": "object",
      "required": [
        "name_en",
        "mesh_term"
      ],
      "properties": {
        "name_en": {
          "type": "string"
        },
        "name_fa": {
          "type": "string"
        },
        "mesh_term": {
          "type": "string"
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "population_or_model": {
      "type": "object",
      "required": [
        "model_type",
        "primary_system"
      ],
      "properties": {
        "model_type": {
          "type": "string",
          "enum": [
            "HUMAN_CLINICAL",
            "HEALTH_SYSTEM_POPULATION",
            "ANIMAL_IN_VIVO",
            "CELL_CULTURE_IN_VITRO",
            "EX_VIVO_TISSUE",
            "IN_SILICO",
            "EVIDENCE_SYNTHESIS_CORPUS",
            "DIGITAL_HEALTH_USERS"
          ]
        },
        "primary_system": {
          "type": "string"
        },
        "secondary_systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "normal_control_system": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "interventions_or_exposures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "chemical_or_biological_class": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "PRIMARY_AGENT",
              "SECONDARY_AGENT",
              "ADJUVANT_AGENT",
              "REFERENCE_DRUG",
              "REFERENCE_STANDARD",
              "EXPOSURE_FACTOR",
              "INDEX_TEST",
              "PRIMARY_OUTCOME_VARIABLE",
              "PCC_CONCEPT",
              "SYSTEM_INTERVENTION"
            ]
          },
          "mesh_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "comparators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "VEHICLE_CONTROL",
              "NEGATIVE_CONTROL",
              "POSITIVE_CONTROL",
              "PLACEBO",
              "STANDARD_OF_CARE",
              "GOLD_STANDARD",
              "HISTORICAL_BASELINE",
              "NO_COMPARATOR_PCC",
              "ALTERNATIVE_WORKFLOW"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "primary_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "measurement_unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "EFFICACY",
              "VIABILITY",
              "TOXICITY",
              "SYNERGY",
              "MORTALITY",
              "SENSITIVITY",
              "SPECIFICITY",
              "HAZARD_RATIO",
              "PREVALENCE",
              "ROC_AUC",
              "CHE_INCIDENCE",
              "USABILITY_SUS",
              "EVIDENCE_MAP"
            ]
          },
          "measurement_unit": {
            "type": "string"
          },
          "preferred_assays": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "hypothesized_mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pathway_name",
          "target_molecules"
        ],
        "properties": {
          "pathway_name": {
            "type": "string"
          },
          "target_molecules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_modulation": {
            "type": "string",
            "enum": [
              "UPREGULATION",
              "DOWNREGULATION",
              "PHOSPHORYLATION",
              "INHIBITION",
              "CLEAVAGE",
              "SECRETION"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "controlled_vocabulary": {
      "type": "object",
      "required": [
        "primary_mesh",
        "all_synonyms"
      ],
      "properties": {
        "primary_mesh": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "all_synonyms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusion_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "eligibility_criteria": {
      "type": "object",
      "properties": {
        "inclusion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "specific_objectives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hypotheses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "endpoints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "decomposition": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
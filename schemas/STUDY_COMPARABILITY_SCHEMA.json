{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudyComparabilityMatrixSchema",
  "description": "Study-design-aware comparability schema evaluating pairwise compatibility across experimental, animal, clinical, and diagnostic studies.",
  "type": "object",
  "required": ["comparability_pairs", "summary"],
  "properties": {
    "comparability_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "study_a_id",
          "study_b_id",
          "shared_design_category",
          "evaluated_dimensions",
          "overall_comparability"
        ],
        "properties": {
          "study_a_id": { "type": "string" },
          "study_b_id": { "type": "string" },
          "shared_design_category": {
            "type": "string",
            "enum": ["IN_VITRO", "IN_VIVO_ANIMAL", "CLINICAL_TRIAL", "OBSERVATIONAL", "DIAGNOSTIC", "CROSS_DESIGN"]
          },
          "evaluated_dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["dimension_name", "status"],
              "properties": {
                "dimension_name": { "type": "string" },
                "study_a_value": { "type": "string" },
                "study_b_value": { "type": "string" },
                "status": {
                  "type": "string",
                  "enum": ["MATCH", "MINOR_DIFFERENCE", "MAJOR_DIVERGENCE", "NOT_REPORTED"]
                },
                "impact_on_synthesis": { "type": "string" }
              }
            }
          },
          "overall_comparability": {
            "type": "string",
            "enum": ["HIGH_COMPARABILITY", "MODERATE_COMPARABILITY", "LOW_COMPARABILITY", "INCOMPARABLE_METHODOLOGICAL_CONFLICT"]
          },
          "divergence_explanation": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_pairs_evaluated", "high_comparability_count", "incomparable_count"],
      "properties": {
        "total_pairs_evaluated": { "type": "integer" },
        "high_comparability_count": { "type": "integer" },
        "incomparable_count": { "type": "integer" }
      }
    }
  }
}
